# Free Groq API Key (optional — only needed when forwarding live calls to Groq)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Local Ollama base URL (100% free local inference)
OLLAMA_BASE_URL=http://localhost:11434

# Local SQLite database path for storing LLM observability events
LLM_OBS_DB_PATH=llm_observability.db

# FastAPI dashboard & collector server settings
LLM_OBS_HOST=127.0.0.1
LLM_OBS_PORT=8080
